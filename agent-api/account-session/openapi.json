          },
          "403": {
            "$ref": "#/components/responses/ApiError"
          },
          "429": {
            "$ref": "#/components/responses/ApiError"
          }
        }
      }
    },
    "/storage/v1/object/goal-media/{userId}/proof/{filename}": {
      "post": {
        "operationId": "uploadProof",
        "summary": "Upload new private photo; userId must equal your authenticated ID",
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "filename",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "x-upsert",
            "in": "header",
            "schema": {
              "type": "string",
              "enum": ["false"],
              "default": "false"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "description": "Maximum 10 MiB. Use a unique UUID filename; overwrites are not permitted.",
          "content": {
            "image/jpeg": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            },
            "image/png": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            },
            "image/heic": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            },
            "image/heif": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "Key": {
                      "type": "string"
                    },
                    "Id": {
                      "type": "string",
                      "format": "uuid"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ApiError"
          },
          "401": {
            "$ref": "#/components/responses/ApiError"
          },
          "403": {
            "$ref": "#/components/responses/ApiError"
          },
          "429": {
            "$ref": "#/components/responses/ApiError"
          }
        }
      }
    },
    "/storage/v1/object/sign/goal-media/{userId}/proof/{filename}": {
      "post": {
        "operationId": "signProofUrl",
        "summary": "Get a short-lived link for an authorized proof image",
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "filename",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "expiresIn": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 3600,
                    "default": 300
                  }
                },
                "required": ["expiresIn"],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "signedURL": {
                      "type": "string",
                      "description": "Path relative to /storage/v1; contains a bearer token. Do not publish."
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ApiError"
          },
          "401": {
            "$ref": "#/components/responses/ApiError"
          },
          "403": {
            "$ref": "#/components/responses/ApiError"
          },
          "429": {
            "$ref": "#/components/responses/ApiError"
          }
        }
      }
    },
    "/rest/v1/rpc/create_text_goal_v2": {
      "post": {
        "operationId": "create_text_goal_v2",
        "summary": "Sequential goal intent with a durable caller request UUID",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "p_caption": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  "p_request_id": {
                    "type": "string",
                    "format": "uuid"
                  }
                },
                "required": ["p_caption", "p_request_id"],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Goal"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ApiError"
          },
          "401": {
            "$ref": "#/components/responses/ApiError"
          },
          "403": {
            "$ref": "#/components/responses/ApiError"
          },
          "429": {
            "$ref": "#/components/responses/ApiError"
          }
        },
        "description": "Persist p_request_id before sending. Same normalized intent replays the original entry after completion or rollover. Changed payload: goal.idempotency_conflict. An unfinished reservation: goal.active_exists. Carrying the same source again today: goal.already_carried."
      }
    },
    "/rest/v1/rpc/carry_goal_v2": {
      "post": {
        "operationId": "carry_goal_v2",
        "summary": "Sequential goal intent with a durable caller request UUID",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "p_entry_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "p_request_id": {
                    "type": "string",
                    "format": "uuid"
                  }
                },
                "required": ["p_entry_id", "p_request_id"],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Goal"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ApiError"
          },
          "401": {
            "$ref": "#/components/responses/ApiError"
          },
          "403": {
            "$ref": "#/components/responses/ApiError"
          },
          "429": {
            "$ref": "#/components/responses/ApiError"
          }
        },
        "description": "Persist p_request_id before sending. Same normalized intent replays the original entry after completion or rollover. Changed payload: goal.idempotency_conflict. An unfinished reservation: goal.active_exists. Carrying the same source again today: goal.already_carried."
      }
    },
    "/rest/v1/rpc/list_completion_feed_v2": {
      "post": {
        "operationId": "list_completion_feed_v2",
        "summary": "Completed goals from self and accepted unblocked friends",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "p_limit": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 50,
                    "default": 20
                  },
                  "p_before_completed_at": {
                    "type": "string",
                    "format": "date-time",
                    "nullable": true
                  },
                  "p_before_id": {
                    "type": "string",
                    "format": "uuid",
                    "nullable": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Goal"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ApiError"
          },
          "401": {
            "$ref": "#/components/responses/ApiError"
          },
          "403": {
            "$ref": "#/components/responses/ApiError"
          },
          "429": {
            "$ref": "#/components/responses/ApiError"
          }
        },
        "description": "Newest first by completed_at DESC, entry_id DESC. Send both cursor fields or neither. Rechecks visibility on every page; photo paths are private and require authorized signing."
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ProjectKey": {
        "type": "apiKey",
        "in": "header",
        "name": "apikey",
        "description": "Public publishable/anon key"
      },
      "UserSession": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Dedicated account's access token"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "details": {
            "type": "string",
            "nullable": true
          },
          "hint": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "Goal": {
        "type": "object",
        "required": ["entry_id", "user_id", "goal_date", "state", "caption"],
        "properties": {
          "entry_id": {
            "type": "string",
            "format": "uuid"
          },
          "user_id": {
            "type": "string",
            "format": "uuid"
          },
          "username": {
            "type": "string"
          },
          "display_name": {
            "type": "string"
          },
          "avatar_path": {
            "type": "string",
            "nullable": true
          },
          "goal_date": {
            "type": "string",
            "format": "date"
          },
          "timezone": {
            "type": "string"
          },
          "caption": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "nullable": true
          },
          "state": {
            "type": "string",
            "enum": ["active", "complete", "removed"]
          },
          "start_photo_path": {
            "type": "string",
            "nullable": true,
            "description": "Legacy field; null for new text-first goals"
          },
          "proof_photo_path": {
            "type": "string",
            "nullable": true
          },
          "completion_note": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "nullable": true
          },
          "completed_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "carried_from_entry_id": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "carried_from_goal_date": {
            "type": "string",
            "format": "date",
            "nullable": true
          },
          "correction_deadline": {
            "type": "string",
            "format": "date-time"
          },
          "edited_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "cheer_count": {
            "type": "integer",
            "minimum": 0
          },
          "cheered_by_me": {
            "type": "boolean"
          }
        }
      },
      "Profile": {
        "type": "object",
        "properties": {
          "profile_id": {
            "type": "string",
            "format": "uuid"
          },
          "username": {
            "type": "string"
          },
          "display_name": {
            "type": "string"
          },
          "avatar_path": {
            "type": "string",
            "nullable": true
          },
          "timezone": {
            "type": "string"
          }
        }
      },
      "Relationship": {
        "type": "object",
        "properties": {
          "relationship_id": {
            "type": "string",
            "format": "uuid"
          },
          "profile_id": {
            "type": "string",
            "format": "uuid"
          },
          "username": {
            "type": "string"
          },
          "display_name": {
            "type": "string"
          },
          "avatar_path": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "type": "string",
            "enum": ["pending", "accepted", "declined", "removed", "blocked"]
          },
          "direction": {
            "type": "string",
            "enum": ["incoming", "outgoing", "mutual", "blockedByMe"]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Session": {
        "type": "object",
        "description": "Sensitive credentials: store in a secret manager, never logs.",
        "properties": {
          "access_token": {
            "type": "string"
          },
          "refresh_token": {
            "type": "string"
          },
          "expires_in": {
            "type": "integer"
          },
          "expires_at": {
            "type": "integer"
          },
          "token_type": {
            "type": "string"
          },
          "user": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "email": {
                "type": "string",
                "format": "email"
              }
            }
          }
        }
      }
    },
    "responses": {
      "ApiError": {
        "description": "Authentication, authorization, validation, conflict or rate limit error. Inspect message for domain errors such as goal.daily_slot_taken. Never blindly retry mutations.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    }
  }
}
