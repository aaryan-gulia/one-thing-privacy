    "/auth/v1/verify": {
      "post": {
        "operationId": "verifyOtp",
        "summary": "Exchange an email OTP for an individual user session",
        "security": [
          {
            "ProjectKey": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "token": {
                    "type": "string",
                    "pattern": "^[0-9]{6}$"
                  },
                  "type": {
                    "type": "string",
                    "enum": ["email"]
                  }
                },
                "required": ["email", "token", "type"],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ApiError"
          },
          "401": {
            "$ref": "#/components/responses/ApiError"
          },
          "403": {
