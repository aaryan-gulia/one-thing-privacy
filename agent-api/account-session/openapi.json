  "openapi": "3.0.3",
  "info": {
    "title": "One Thing Agent API",
    "version": "1.1.0",
    "description": "Full authenticated account sessions. Sequential v2 goals allow one unfinished goal per owner/local day; photo completion releases the slot. Legacy create/carry stay once per day. Accepted-friend completion feeds are session-only. These additive contracts require the sequential migrations; local implementation does not deploy them."
  },
  "servers": [
    {
      "url": "https://zalmsnnwlhbrglpkymne.supabase.co"
    }
  ],
  "security": [
    {
      "ProjectKey": [],
      "UserSession": []
    }
  ],
